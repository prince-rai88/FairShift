{
  "name": "fairshift",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "start": "node server.js",
    "backend:start": "venv/bin/python backend/manage.py runserver 0.0.0.0:8000",
    "backend:migrate": "venv/bin/python backend/manage.py migrate",
    "backend:seed": "venv/bin/python backend/manage.py seed_data",
    "backend:test": "venv/bin/python -c \"import os, subprocess; subprocess.run(['python', 'manage.py', 'test', 'api'], cwd='backend', executable=os.path.abspath('venv/bin/python'))\""
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
